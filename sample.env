# Sample environment variables for Anime Recommendation API
host=127.0.0.1 # server host address
port=8000 # port number for the server to listen on
environment=development # application environment: development or production
version=1.0.0 # version of the Anime Recommendation API
allowed_domains=https://example.com,http://example.com # comma-separated list of allowed CORS origins
ssl_keyfile_path=/path/to/dev/certs/key.pem # path to SSL key file
ssl_certfile_path=/path/to/dev/certs/cert.pem # path to SSL certificate file